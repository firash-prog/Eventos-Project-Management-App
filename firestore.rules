rules_version = '2';

/**
 * EVENTOS - FIRESTORE SECURITY RULES
 * Supports server-side auth operations (Express backend) and client operational data.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // USERNAMES COLLECTION (Used for server-side username -> UID resolution)
    match /usernames/{username} {
      allow read, write: if true;
    }

    // USERS COLLECTION (User accounts & security profiles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // ROLES COLLECTION (System roles & custom permission definitions)
    match /roles/{roleId} {
      allow read, write: if true;
    }

    // CLIENTS CRM COLLECTION
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // RFQs INTAKE COLLECTION
    match /rfqs/{rfqId} {
      allow read, write: if true;
    }

    // APPROVAL REQUESTS COLLECTION
    match /approval_requests/{approvalId} {
      allow read, write: if true;
    }

    // AUDIT LOGS (IMMUTABLE CREATION)
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Catch-all for operational collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
