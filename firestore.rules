rules_version = '2';

/**
 * EVENTOS V8.0 - ENTERPRISE FIRESTORE SECURITY RULES
 * Threat Model: Internal enterprise web app with named users, RBAC, and sensitive event/financial/staff data.
 * Zero Public Access: All paths require authentication.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // HELPER FUNCTIONS
    // --------------------------------------------------------------------------

    // Verify user is authenticated with a valid UID
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Get current user document from `users` collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if authenticated user holds the Superadmin role
    function isSuperadmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.roleId == 'superadmin') ||
        (getUserData() != null && getUserData().roleId == 'superadmin')
      );
    }

    // Check if user is operating on their own record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is an active employee account
    function isActiveUser() {
      return isAuthenticated() && getUserData() != null && getUserData().status != 'Inactive';
    }

    // --------------------------------------------------------------------------
    // COLLECTION: usernames
    // Decoupled Username -> UID resolution map
    // --------------------------------------------------------------------------
    match /usernames/{username} {
      // BLOCK: Unauthenticated enumeration or squatting of username mappings
      // ALLOW: Authenticated users can read map for authentication/lookup
      allow read: if isAuthenticated();

      // BLOCK: Non-superadmins creating or modifying username mappings
      // ONLY superadmin or server Admin SDK can assign username mappings
      allow write: if isSuperadmin();
    }

    // --------------------------------------------------------------------------
    // COLLECTION: roles
    // System & Custom RBAC roles containing permission keys
    // --------------------------------------------------------------------------
    match /roles/{roleId} {
      // ALLOW: All active authenticated staff can read roles to determine permissions
      allow read: if isActiveUser();

      // BLOCK: Non-superadmins creating, updating, or deleting roles
      // Prevents privilege escalation by modifying role permissions
      allow create, update, delete: if isSuperadmin();
    }

    // --------------------------------------------------------------------------
    // COLLECTION: users
    // Staff user profiles, role bindings, and password status
    // --------------------------------------------------------------------------
    match /users/{userId} {
      // ALLOW: All active authenticated staff can read user directory
      allow read: if isActiveUser();

      // ALLOW: Superadmin full management of user accounts
      allow create, delete: if isSuperadmin();

      // ALLOW: User self-update restricted strictly to display preferences
      // BLOCK: Non-superadmins changing roleId, permissions, or resetting password flags
      allow update: if isSuperadmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roleId', 'permissions', 'mustChangePassword', 'username'])
      );
    }

    // --------------------------------------------------------------------------
    // APPLICATION DATA COLLECTIONS (events, shifts, inventory, vendors, budget)
    // Protected by role-based activity checks
    // --------------------------------------------------------------------------
    match /events/{eventId} {
      allow read: if isActiveUser();
      allow write: if isSuperadmin() || (getUserData().permissions.editEvents == true);
    }

    match /shifts/{shiftId} {
      allow read: if isActiveUser();
      allow write: if isSuperadmin() || (getUserData().permissions.resolveConflicts == true);
    }

    match /inventory/{assetId} {
      allow read: if isActiveUser();
      allow write: if isSuperadmin() || (getUserData().permissions.manageInventory == true);
    }

    match /vendors/{vendorId} {
      allow read: if isActiveUser();
      allow write: if isSuperadmin() || (getUserData().permissions.manageVendors == true);
    }

    match /budget/{budgetId} {
      allow read: if isActiveUser() && (getUserData().permissions.viewFinancials == true);
      allow write: if isSuperadmin() || (getUserData().permissions.approveBudget == true);
    }

    match /activity_logs/{logId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
    }
  }
}
