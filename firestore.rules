rules_version = '2';

/**
 * EVENTOS - PHASE 2 FIRESTORE SECURITY RULES
 * Enforces RBAC for Roles, Users, CRM Clients, RFQs, Approval Requests, and Immutable Audit Logs.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRoleData(roleId) {
      return get(/databases/$(database)/documents/roles/$(roleId)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().roleId == 'superadmin' || 
        request.auth.token.email == 'firash@eliteproeventsksa.com'
      );
    }

    function isSystemAdmin() {
      return isAuthenticated() && getUserData().roleId == 'system_admin';
    }

    function hasPermission(permissionKey) {
      let role = getRoleData(getUserData().roleId);
      return role.permissions[permissionKey] == true;
    }

    function isExecutiveOrFinanceOrCR() {
      let roleId = getUserData().roleId;
      let dept = getUserData().department;
      return isSuperAdmin() || isSystemAdmin() || roleId == 'ceo' || roleId == 'assistant_ceo' || dept == 'Customer Relations' || hasPermission('canViewFinance');
    }

    // ROLES COLLECTION
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || (
        isSystemAdmin() && 
        request.resource.data.roleId != 'superadmin' &&
        (!exists(/databases/$(database)/documents/users/$(userId)) || resource.data.roleId != 'superadmin')
      );
      allow delete: if isSuperAdmin();
    }

    // CLIENTS CRM COLLECTION
    match /clients/{clientId} {
      allow read: if isExecutiveOrFinanceOrCR();
      allow create, update: if isExecutiveOrFinanceOrCR();
      allow delete: if isSuperAdmin() || getUserData().roleId == 'ceo';
    }

    // RFQs INTAKE COLLECTION
    match /rfqs/{rfqId} {
      allow read: if isExecutiveOrFinanceOrCR() || (
        isAuthenticated() && (
          resource.data.receivedByUid == request.auth.uid ||
          (request.auth.uid in resource.data.assignedPricerUids)
        )
      );
      allow create: if isAuthenticated();
      allow update: if isExecutiveOrFinanceOrCR() || (
        isAuthenticated() && (
          resource.data.receivedByUid == request.auth.uid ||
          (request.auth.uid in resource.data.assignedPricerUids)
        )
      );
      allow delete: if isSuperAdmin() || getUserData().roleId == 'ceo';
    }

    // APPROVAL REQUESTS (UNIFIED ENGINE)
    match /approval_requests/{approvalId} {
      allow read: if isAuthenticated() && (
        resource.data.requesterUid == request.auth.uid ||
        hasPermission('canApproveQuotations') ||
        hasPermission('canApproveBudgets') ||
        isSuperAdmin() ||
        isSystemAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        hasPermission('canApproveQuotations') || 
        hasPermission('canApproveBudgets') ||
        isSuperAdmin()
      );
    }

    // AUDIT LOGS (IMMUTABLE)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || isSystemAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Catch-all for authenticated operational collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
